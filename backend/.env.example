# Copy this file to .env and fill in real values.

CORS_ORIGINS=*

TOKEN_TTL_HOURS=72
OTP_LENGTH=4
OTP_TTL_SEC=300
OTP_RESEND_SEC=24

# --- WhatsApp Business API ---
# Keep WA_DRY_RUN=true until the fields below are filled in — every send
# is logged to the console (full request payload) instead of actually sent.
WA_DRY_RUN=true

# From "WhatsApp API Setup Documentation": host + version + your IDs/key.
# Request URL becomes: {WA_API_BASE_URL}/{WA_VERSION}/{WA_PHONE_NUMBER_ID}/messages
WA_API_BASE_URL=https://yourdomain.com
WA_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_API_KEY=

# Must match the *approved* template names/language in your WABA — see
# scripts/manage_templates.py to create and check them.
WA_TEMPLATE_LANG=en
WA_TEMPLATE_OTP=
WA_TEMPLATE_BOOKING_CONFIRMED=
WA_TEMPLATE_BOOKING_CANCELLED=
